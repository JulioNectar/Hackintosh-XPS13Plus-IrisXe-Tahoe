+bool Gen11::wrapInitSegments(void *that)
+{
+	FunctionCast(wrapInitSegments, callback->owrapInitSegments)(that);
+	if (that) {
+		void *fbMemMgr = getMember<void *>(that, 0x70);
+		uint64_t aperLen = 0x10000000ULL;
+		if (fbMemMgr) {
