+	void *ctrl = fPriv ? getMember<void *>(fPriv, 0x0) : nullptr;
+	void *wl = ctrl ? getMember<void *>(ctrl, 0x120) : nullptr;
+	void *memMgr = accel ? getMember<void *>(accel, 0x1260) : nullptr;
